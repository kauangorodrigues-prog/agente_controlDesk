# ── Aplicação ────────────────────────────────────────────────
APP_NAME=ControlDesk Cobranças SaaS
APP_ENV=development
DEBUG=true

# ── Banco de Dados ───────────────────────────────────────────
# Desenvolvimento (padrão): SQLite, zero-config.
DATABASE_URL=sqlite:///./controldesk.db
# Produção (PostgreSQL) — instale psycopg (ver requirements.txt):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cobranca

# ── Segurança / JWT ──────────────────────────────────────────
# GERE UMA CHAVE FORTE EM PRODUÇÃO:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-key-TROQUE-EM-PRODUCAO
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# ── Criptografia de dados em repouso (CPF/CNPJ) ──────────────
# GERE CHAVES FORTES EM PRODUÇÃO: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=dev-data-encryption-key-TROQUE-EM-PRODUCAO
DATA_INDEX_KEY=dev-blind-index-key-TROQUE-EM-PRODUCAO

# ── Proteção de login (brute-force) ──────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ── CORS (origens do front-end) ──────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LGPD ─────────────────────────────────────────────────────
DATA_CONTROLLER_NAME=ControlDesk Cobranças LTDA
DPO_EMAIL=dpo@controldesk.example.com
LGPD_RETENTION_DAYS=1825

# ── Bootstrap do primeiro admin (usado pelo seed) ────────────
FIRST_ADMIN_EMAIL=admin@controldesk.example.com
FIRST_ADMIN_PASSWORD=Admin@123456
