# ============================================================
# Agente IA Control Desk — variáveis de ambiente
# Copie para .env e ajuste:  cp .env.example .env
# ============================================================

# ── Banco de Dados (PostgreSQL) ─────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=control_desk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# ── API do Discador ─────────────────────────────────────────
DIALER_BASE_URL=https://api.seu-discador.example.com
DIALER_TOKEN=

# ── API do Cobrador / CRM ───────────────────────────────────
COLLECTOR_BASE_URL=https://api.seu-cobrador.example.com
COLLECTOR_TOKEN=

# ── Alertas ─────────────────────────────────────────────────
WEBHOOK_ALERTA=
EMAIL_SMTP=
EMAIL_PORTA=587
EMAIL_USER=
EMAIL_SENHA=
EMAIL_DESTINOS=

# ── Segurança / JWT ─────────────────────────────────────────
# GERE UM SEGREDO FORTE, ex.: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=TROQUE_EM_PRODUCAO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Limites operacionais ────────────────────────────────────
LIMITE_OCIOSIDADE_PCT=15.0
LIMITE_ABANDONO_PCT=8.0
LIMITE_MAILING_RESTANTE_PCT=5.0
LIMITE_PAUSA_MIN=20
INTERVALO_MONITOR_SEG=120
THROTTLE_ALERTAS_SEG=300

# ── Guardrails de Pacing ────────────────────────────────────
PACING_HORA_INICIO_GLOBAL=08:00
PACING_HORA_FIM_GLOBAL=21:00
PACING_HORA_FIM_SABADO=16:00
PACING_MAX_GLOBAL=8.0
PACING_MIN_GLOBAL=1.0
PAUSAR_EM_FERIADOS=true

# ── Ambiente ────────────────────────────────────────────────
AMBIENTE=development
LOG_LEVEL=INFO
