# Copie para .env e preencha antes de `docker compose up -d`.

# Segurança (OBRIGATÓRIO) — gere com: openssl rand -base64 32
ROBO_ALO_API_KEY=
# Senha do Postgres (OBRIGATÓRIO) — gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Porta publicada no host
ROBO_ALO_PORT=5501
# Workers (≈ 1 por núcleo de CPU)
ROBO_ALO_WORKERS=2
# Requisições/min por IP
ROBO_ALO_RATE_LIMIT=120
# Origens de navegador permitidas (CSV). Vazio = cross-origin bloqueado.
ROBO_ALO_CORS_ORIGINS=

# Modo de análise: hibrido (recomendado) | heuristica | ia
ALO_MODO=hibrido
ALO_HIBRIDO_LIMIAR=80
# IA (opcional). Sem chave, o híbrido roda 100% na heurística, sem custo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Banco (nomes internos do compose — normalmente não precisa mudar)
POSTGRES_DB=alo
POSTGRES_USER=alo
