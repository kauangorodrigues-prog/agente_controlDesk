# NexusAI Control Desk — configuration
# Every value below is OPTIONAL. The app runs out of the box with sensible
# defaults (embedded SQLite + local email/password auth). Copy this file to
# `.env` only if you want to override something.

# ── Auth ────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Set a long random value in production.
APP_SECRET=

# ── Database ────────────────────────────────────────────────────
# Path to the SQLite file (or sqlite:// / file: URL).
# Defaults to ./data/controldesk.db
DATABASE_URL=

# ── Admin account ───────────────────────────────────────────────
# The account with this e-mail is created as "admin" on first boot and any
# sign-up using it is promoted to admin. Default: admin@nexusai.com
OWNER_EMAIL=

# ── Server ──────────────────────────────────────────────────────
# Port used in production (`npm start`). Defaults to 3000.
PORT=
